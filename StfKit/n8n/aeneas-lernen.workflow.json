      }
    },
    {
      "id": "9f97de50-2646-4212-8318-c85831115749",
      "name": "Lernen (StfKit)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiUrl + '/learn' }}",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ generatedStf: $json.generiert, correctedStf: $json.korrigiert, name: $json.name || null }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "bc0cb88a-3aaa-4dbc-8303-3263f881d938",
      "name": "Bericht",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst cfg = $('Konfiguration').first().json;\nconst r = $json;\nconst esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nlet subject, h;\nif (r.ok !== true) {\n  subject = 'Aeneas-Formulare lernen: FEHLER';\n  h = `<p>Die Korrektur konnte nicht verarbeitet werden:</p><p><code>${esc(r.error?.message || r.error || JSON.stringify(r))}</code></p>`;\n} else {\n  const x = r.report, c = x.calibrationAfter;\n  subject = `Aeneas-Formulare lernen: ${x.slotsAdded} neue Feld-Zuordnungen, ${x.textPairs} Textpaare verglichen`;\n  h = `<p>Die KI hat aus der Korrektur von <b>${esc(x.form)}</b> gelernt.</p><ul>` +\n    `<li>Verglichene Textboxen: ${x.textPairs} (erzeugt ${x.generatedBoxes}, korrigiert ${x.correctedBoxes}); Linien/Rahmen: ${x.linePairs}</li>` +\n    `<li>Neue Zuordnungen „Feld-Beschriftung → Platzhalter“: <b>${x.slotsAdded}</b> (aktualisiert ${x.slotsUpdated})</li>` +\n    `<li>Neue Text-Ersetzungen mit Platzhaltern: <b>${x.rewritesAdded}</b>; reine Textkorrekturen nur protokolliert: ${x.textEditsLogged}</li>` +\n    `<li>Positionskorrektur: Text dx ${x.dxShift?.toFixed?.(2) ?? '–'} / dy ${x.dyShift?.toFixed?.(2) ?? '–'} mm → Kalibrierung jetzt Dx ${c.dx}, Dy ${c.dy} (Basis: ${c.corrections} Korrektur(en))</li></ul>`;\n  if (x.notes?.length) h += '<p>Hinweise:</p><ul>' + x.notes.map(n => `<li>${esc(n)}</li>`).join('') + '</ul>';\n  h += '<p>Das Gelernte wird bei der nächsten Erzeugung automatisch verwendet. Je mehr Korrekturen, desto verlässlicher.</p>';\n}\nreturn { json: { subject, html: h, to: cfg.email, from: cfg.mailFrom } };\n"
      }
    },
    {
      "id": "2b734650-58a5-43a1-9aff-748d065042f6",
      "name": "Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        200
      ],
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "SMTP Haneke"
        }
      }
    }
  ],
