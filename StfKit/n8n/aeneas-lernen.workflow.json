            },
            {
              "id": "497179dc-87c0-4255-8710-e326cb0d6bb2",
              "name": "generiert",
              "value": "={{ $json['Von der KI erzeugte Datei (.stf)'] }}",
              "type": "string"
            },
            {
              "id": "fe313566-f6ae-4d05-b5d7-b13664545b93",
              "name": "korrigiert",
              "value": "={{ $json['Korrigierte Datei (.stf)'] }}",
