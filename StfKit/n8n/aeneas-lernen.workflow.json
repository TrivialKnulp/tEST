      ],
      "parameters": {
        "formTitle": "Aeneas-Formulare: Korrektur melden (die KI lernt daraus)",
        "formDescription": "Pfad der von der KI erzeugten .stf und der danach in Aeneas korrigierten .stf (Aeneas: Formulare bearbeiten → Speichern unter). Beide Dateien müssen unter den erlaubten Verzeichnissen des Dienstes liegen.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Von der KI erzeugte Datei (.stf)",
              "requiredField": true
            },
            {
              "fieldLabel": "Korrigierte Datei (.stf)",
              "requiredField": true
            },
            {
              "fieldLabel": "Name des Formulars (optional)",
              "requiredField": false
            },
            {
              "fieldLabel": "E-Mail für Benachrichtigung",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "webhookId": "fa01d348-c8b0-4731-9fdf-ab7df5eaddcd"
    },
    {
      "id": "681a95c0-74f6-4e7b-be2e-c0e3ffa161f1",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "576312cd-43b0-4ab6-b42a-90e0e7bb7f34",
              "name": "apiUrl",
              "value": "http://localhost:5077",
              "type": "string"
            },
            {
              "id": "975c00cf-aa0d-4f25-b6ea-028eb23f7662",
              "name": "mailFrom",
              "value": "ki@haneke.de",
