      ],
      "parameters": {
        "formTitle": "Aeneas-Formulare: Korrektur melden (die KI lernt daraus)",
        "formDescription": "Die in Aeneas korrigierte .stf hochladen (Aeneas: Formulare bearbeiten → Speichern unter) und den Pfad der von der KI erzeugten .stf angeben (steht im Bericht). Die KI lernt aus dem Unterschied; die korrigierte Fassung wird außerdem in Qdrant aufgenommen und steht künftig als Vorlage zur Verfügung.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Korrigierte STF-Datei",
              "fieldType": "file",
              "acceptFileTypes": ".stf",
              "requiredField": true
            },
            {
              "fieldLabel": "Pfad der von der KI erzeugten STF-Datei",
              "requiredField": true
            },
            {
              "fieldLabel": "Name des Formulars (optional)",
              "requiredField": false
            },
            {
              "fieldLabel": "E-Mail für Benachrichtigung",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "webhookId": "7d0f216d-0d7d-4c74-ae46-83043d30611a"
    },
    {
      "id": "681a95c0-74f6-4e7b-be2e-c0e3ffa161f1",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "576312cd-43b0-4ab6-b42a-90e0e7bb7f34",
              "name": "apiUrl",
              "value": "http://IP-DES-PC-MIT-STFKIT-API:5077",
              "type": "string"
            },
            {
              "id": "975c00cf-aa0d-4f25-b6ea-028eb23f7662",
              "name": "mailFrom",
              "value": "ki@haneke.de",
